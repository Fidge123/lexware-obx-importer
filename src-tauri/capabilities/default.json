{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "updater:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://api.lexware.io/"
        },
        {
          "url": "https://koettermann.iw-erp.de/"
        },
        {
          "url": "https://eu.i.posthog.com/"
        }
      ]
    },
    "http:default",
    "fs:default",
    "os:default"
  ]
}
