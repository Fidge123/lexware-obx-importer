{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "askUserQuestionTimeout": "never",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun install",
            "timeout": 10,
            "statusMessage": "Installing TS dependencies..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun lint",
            "timeout": 10,
            "statusMessage": "Linting..."
          },
          {
            "type": "command",
            "command": "bun test",
            "timeout": 20,
            "statusMessage": "Running TS tests..."
          }
        ]
      }
    ]
  }
}
